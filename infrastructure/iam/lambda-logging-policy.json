{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "WriteTransactionApiLambdaLogs",
      "Effect": "Allow",
      "Action": [
        "logs:CreateLogStream",
        "logs:PutLogEvents"
      ],
      "Resource": "arn:aws:logs:ca-central-1:000000000000:log-group:/aws/lambda/transaction-api-lambda:*"
    }
  ]
}